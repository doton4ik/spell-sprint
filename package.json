{
  "name": "spell-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:classifier": "node scripts/check-classifier.mjs",
    "check:proofreading": "node scripts/check-proofreading.mjs",
    "check:pairs": "node scripts/check-pairs.mjs",
    "check:library": "node scripts/check-library.mjs",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:library && pnpm check:pairs && pnpm check:classifier && pnpm check:proofreading && pnpm check:rules",
    "test": "vitest run",
    "lint": "oxlint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm build && playwright test",
    "check:rules": "node scripts/check-rules.mjs",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
