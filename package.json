{
  "name": "spell-sprint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:classifier": "node scripts/check-classifier.mjs",
    "check:proofreading": "node scripts/check-proofreading.mjs",
    "check:pairs": "node scripts/check-pairs.mjs",
    "check:library": "node scripts/check-library.mjs",
    "typecheck": "tsc -b",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:library && pnpm check:pairs && pnpm check:classifier && pnpm check:proofreading && pnpm check:rules",
    "test": "vitest run",
    "lint": "oxlint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm build && playwright test",
    "check:rules": "node scripts/check-rules.mjs",
    "backup": "node scripts/backup.mjs",
    "app:sync": "pnpm build && cap sync",
    "app:icons": "node scripts/make-icons.mjs && capacitor-assets generate --iconBackgroundColor '#2d4f80' --iconBackgroundColorDark '#2d4f80' --splashBackgroundColor '#f5f0e6' --splashBackgroundColorDark '#14110d' && git checkout public/manifest.webmanifest public/icons/spell-sprint-icon.svg && node -e \"require('fs').rmSync('icons',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  }
}
