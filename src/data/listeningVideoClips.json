    "lines": [
      {
        "text": "I'm Beth. And I'm Neil.",
        "start": 13.1,
        "end": 15.2,
        "wordStarts": [13.28, 13.48, 13.96, 14.22, 14.64]
      },
      {
        "text": "Phew, I've spent a day in meetings,",
