# Create a .env.local file with these values from Supabase Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: "on" shows "Forgot password?" — only when Supabase can send email (Authentication → Emails → SMTP).
VITE_PASSWORD_RESET_EMAIL=off
